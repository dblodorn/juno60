{
  "name": "@dblodorn/roland-juno60-engine",
  "version": "0.2.0",
  "description": "An approximate Roland Juno-60 emulator as a sound source: load patches, play notes, in an AudioWorklet or offline.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dblodorn/juno60.git",
    "directory": "packages/roland-juno60-engine"
  },
  "exports": {
    ".": "./src/index.ts",
    "./worklet.js": "./dist/worklet.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./worklet.js": "./dist/worklet.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:worklet": "node scripts/build-worklet.ts",
    "test": "pnpm build:worklet && node --expose-gc --test 'test/**/*.test.ts'",
    "typecheck": "pnpm build:worklet && tsc --noEmit",
    "build": "rm -rf dist && pnpm build:worklet && tsc -p tsconfig.build.json && node scripts/rewrite-dts.ts",
    "smoke": "node scripts/smoke-pack.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.25.12",
    "typescript": "~5.9.3"
  }
}
